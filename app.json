{
  "expo": {
    "name": "Contact Manager",
    "slug": "contact-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F5F7FB"
    },
    "android": {
      "package": "com.contactmanager.app",
      "adaptiveIcon": {
        "backgroundColor": "#2563EB"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Contact Manager to choose a picture for a contact.",
          "cameraPermission": "Allow Contact Manager to take a picture for a contact.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "58f1502a-b0d6-48e1-982a-5d832a2d32b5"
      }
    }
  }
}
